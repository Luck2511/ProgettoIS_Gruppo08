<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="it.unina.registroelettronico.Boundary.Swing.SchermataClasse">
  <grid id="27dc6" binding="contentPane" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="18">
    <margin top="24" left="28" bottom="24" right="28"/>
    <constraints>
      <xy x="20" y="20" width="820" height="650"/>
    </constraints>
    <properties>
      <background color="-1116929"/>
      <font name="Arial"/>
      <opaque value="true"/>
      <preferredSize width="820" height="650"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="headerCard" layout-manager="GridLayoutManager" row-count="3" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="14" vgap="5">
        <margin top="18" left="22" bottom="18" right="22"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-1"/>
          <opaque value="true"/>
        </properties>
        <border type="empty"/>
        <children>
          <component id="lblNomeClasse" class="javax.swing.JLabel" binding="lblNomeClasse">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="27" style="1"/>
              <foreground color="-14730405"/>
              <text value="Nome classe"/>
            </properties>
          </component>
          <component id="lblCodiceClasse" class="javax.swing.JLabel" binding="lblCodiceClasse">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="14" style="1"/>
              <foreground color="-12877066"/>
              <text value="Codice classe: CLASSE-XXXX"/>
            </properties>
          </component>
          <component id="lblSottotitolo" class="javax.swing.JLabel" binding="lblSottotitolo">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="13" style="0"/>
              <foreground color="-10785926"/>
              <text value="Gestisci gli studenti della classe e accedi al registro."/>
            </properties>
          </component>
          <component id="btnApriRegistro" class="javax.swing.JButton" binding="btnApriRegistro">
            <constraints>
              <grid row="0" column="1" row-span="3" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-12877066"/>
              <focusPainted value="false"/>
              <font size="14" style="1"/>
              <foreground color="-1"/>
              <opaque value="true"/>
              <preferredSize width="165" height="42"/>
              <text value="Apri registro"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="studentsCard" layout-manager="GridLayoutManager" row-count="3" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="10">
        <margin top="18" left="22" bottom="20" right="22"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-1"/>
          <opaque value="true"/>
        </properties>
        <border type="empty"/>
        <children>
          <component id="lblStudentiTitolo" class="javax.swing.JLabel" binding="lblStudentiTitolo">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="19" style="1"/>
              <foreground color="-14730405"/>
              <text value="Studenti iscritti"/>
            </properties>
          </component>
          <component id="btnAggiungiStudente" class="javax.swing.JButton" binding="btnAggiungiStudente">
            <constraints>
              <grid row="0" column="1" row-span="2" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-525569"/>
              <focusPainted value="false"/>
              <font size="13" style="1"/>
              <foreground color="-12877066"/>
              <opaque value="true"/>
              <preferredSize width="175" height="38"/>
              <text value="+  Aggiungi studente"/>
            </properties>
          </component>
          <component id="lblStudentiHint" class="javax.swing.JLabel" binding="lblStudentiHint">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="12" style="0"/>
              <foreground color="-10785926"/>
              <text value="Elenco degli studenti attualmente associati alla classe."/>
            </properties>
          </component>
          <scrollpane id="scrollStudenti" binding="scrollStudenti">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-525569"/>
              <opaque value="true"/>
              <preferredSize width="720" height="340"/>
            </properties>
            <border type="empty"/>
            <children>
              <component id="lstStudenti" class="javax.swing.JList" binding="lstStudenti">
                <constraints/>
                <properties>
                  <background color="-525569"/>
                  <font size="14" style="0"/>
                  <foreground color="-14730405"/>
                  <selectionMode value="0"/>
                  <visibleRowCount value="10"/>
                </properties>
              </component>
            </children>
          </scrollpane>
        </children>
      </grid>
    </children>
  </grid>
</form>
